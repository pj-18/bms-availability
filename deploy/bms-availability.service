[Unit]
Description=BookMyShow availability checker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit these two paths for your machine before installing.
WorkingDirectory=/path/to/bms-availability
EnvironmentFile=/path/to/bms-availability/.env
ExecStart=/usr/bin/python3 /path/to/bms-availability/run_scheduler.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
