# Lets the deploy user restart/check the checker service without a sudo
# password prompt, which the vm-start GitHub Actions workflow needs since
# it runs non-interactively over SSH. Grants nothing else.
#
# Install with:
#   sudo cp deploy/sudoers-bms-availability /etc/sudoers.d/bms-availability
#   sudo chmod 440 /etc/sudoers.d/bms-availability
#
# Replace DEPLOY_USER with the actual username the workflow SSHes in as
# (matches the VM_USERNAME secret).
DEPLOY_USER ALL=(root) NOPASSWD: /bin/systemctl restart bms-availability, /bin/systemctl is-active bms-availability
